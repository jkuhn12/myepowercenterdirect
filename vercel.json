{
  "version": 2,
  "builds": [
    { "src": "index.php", "use": "vercel-php@0.9.0" },
    { "src": "admin.php", "use": "vercel-php@0.9.0" }
  ],
  "routes": [
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/admin.php", "dest": "/admin.php" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
